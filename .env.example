# Copy to .env and adjust. .env is git ignored, this file is not.

# Where the suite points. Change it to run against another deployment of the
# app; the page objects navigate relative to this.
BASE_URL=https://www.saucedemo.com

# The two users and their shared password, all required. They are public on
# the app's login page; on CI they are repository variables and a secret.
SAUCE_STANDARD_USER=standard_user
SAUCE_PROBLEM_USER=problem_user
SAUCE_PASSWORD=secret_sauce

# The users to run as, comma-separated: each browser runs a describe per user (ADR 0016).
# Unset, both.
# SAUCE_USERS=problem_user

# Replays the test data of an earlier run. Take it from the "faker seed" a test
# shows in the report. Unset, every run draws its own.
# FAKER_SEED=

# Only for publishing a report to Cloudflare Pages by hand with Wrangler, which
# reads them from .env on its own. The tests do not need them; CI takes them
# from secrets (README, Environment). Keep the real token out of this file.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Only for the AI judge (npm run judge, npm run judge:golden): an OpenRouter key
# for TypeSafe's Jev (ADR 0020). CI reads it from the OPENROUTER_API_KEY secret.
# Keep the real key out of this file.
OPENROUTER_API_KEY=
